    {"semanticIntent": "negative-friction", "eventTypes": ["semanticProblemMap"], "semanticRole": "semantic-problem-map", "primarySfxIntent": "negative_warning"},
    {"semanticIntent": "negative-to-positive", "eventTypes": ["semanticProblemMap"], "semanticRole": "semantic-problem-map", "primarySfxIntent": "negative_warning"},
    {"semanticIntent": "positive-confirm", "eventTypes": ["captionHighlight"], "semanticRole": "positive-confirm", "primarySfxIntent": "confirm"},
    {"semanticIntent": "automation-handoff", "eventTypes": ["automationHandoff"], "semanticRole": "automation-handoff", "primarySfxIntent": "automation_handoff"},
