{
  "schema": "ngg-koubo-v4-presentation-rules",
  "version": 1,
  "format": "portrait",
  "sourceOfTruth": "scripts/visual_event_builder.py",
  "presenterLayoutPolicy": {
    "automaticAllowed": ["fullscreen", "large", "pip", "none"],
    "manualOnly": ["side"],
    "manualSources": ["manual-approved", "legacy-project"],
    "sideHudMovesPresenter": false,
    "impactEventChangesPosition": false
  },
  "semanticToPresentation": [
    {"semanticIntent": "topic-intro", "eventTypes": ["topicKeyword"], "semanticRole": "topic-intro", "primarySfxIntent": null},
    {"semanticIntent": "explanation-claim", "eventTypes": ["claimStrip", "quoteSource", "statusSticker"], "semanticRole": "explanation-claim", "primarySfxIntent": null},
    {"semanticIntent": "result-promise", "eventTypes": ["kineticTitle", "bigJudgement"], "semanticRole": "result-promise", "primarySfxIntent": "title_impact"},
    {"semanticIntent": "negative-friction", "eventTypes": ["semanticProblemMap", "highlightBox", "kineticTitle", "statusSticker"], "semanticRole": "semantic-problem-map", "primarySfxIntent": "negative_warning"},
    {"semanticIntent": "negative-to-positive", "eventTypes": ["semanticProblemMap", "highlightBox"], "semanticRole": "semantic-problem-map", "primarySfxIntent": "negative_warning"},
    {"semanticIntent": "positive-confirm", "eventTypes": ["captionHighlight", "statusSticker"], "semanticRole": "positive-confirm", "primarySfxIntent": "confirm"},
    {"semanticIntent": "automation-handoff", "eventTypes": ["automationHandoff", "captionHighlight", "flowPath", "statusStack"], "semanticRole": "automation-handoff", "primarySfxIntent": "automation_handoff"},
    {"semanticIntent": "numeric-metric", "eventTypes": ["dataPunch", "metricSpotlight"], "semanticRole": "numeric-metric", "primarySfxIntent": "data_count"},
    {"semanticIntent": "proof-material", "eventTypes": ["materialMain", "statusSticker"], "semanticRole": "proof-material", "primarySfxIntent": "proof_reveal"},
    {"semanticIntent": "workflow-step", "eventTypes": ["flowPath", "statusStack", "compactPipeline", "captionHighlight"], "semanticRole": "workflow-step", "primarySfxIntent": null},
    {"semanticIntent": "paired-inputs", "eventTypes": ["pairedInputRail"], "semanticRole": "paired-inputs", "primarySfxIntent": null},
    {"semanticIntent": "parallel-factors", "eventTypes": ["factorTrinity"], "semanticRole": "parallel-factors", "primarySfxIntent": null},
    {"semanticIntent": "causal-driver", "eventTypes": ["causalDriver"], "semanticRole": "causal-driver", "primarySfxIntent": null},
    {"semanticIntent": "factor-priority", "eventTypes": ["factorPriority"], "semanticRole": "factor-priority", "primarySfxIntent": null},
    {"semanticIntent": "limitation-boundary", "eventTypes": ["limitationWarning"], "semanticRole": "limitation-boundary", "primarySfxIntent": "negative_warning"},
    {"semanticIntent": "prerequisite", "eventTypes": ["priorityConclusion", "historicalGreenConclusion"], "semanticRole": "prerequisite", "primarySfxIntent": null, "automaticDefault": "priorityConclusion", "manualVariants": [{"eventType": "historicalGreenConclusion", "requires": {"presentationVariant": "manual-approved"}}]},
    {"semanticIntent": "workflow-fields", "eventTypes": ["flowPath", "statusStack", "captionHighlight"], "semanticRole": "workflow-step", "primarySfxIntent": null},
    {"semanticIntent": "enumeration", "eventTypes": ["flowPath", "statusStack"], "semanticRole": "workflow-step", "primarySfxIntent": null},
    {"semanticIntent": "manual-field", "eventTypes": ["infoCard"], "semanticRole": "manual-field", "primarySfxIntent": null},
    {"semanticIntent": "capability-share", "eventTypes": ["capabilityShare"], "semanticRole": "capability-share", "primarySfxIntent": null},
    {"semanticIntent": "scene-lock", "eventTypes": ["sceneLockGrid"], "semanticRole": "scene-lock", "primarySfxIntent": null},
    {"semanticIntent": "asset-variants", "eventTypes": ["ratioGallery", "flowPath", "materialMain"], "semanticRole": "asset-variants", "primarySfxIntent": null},
    {"semanticIntent": "platform-fanout", "eventTypes": ["transitionPushZoom", "platformFanout"], "semanticRole": "platform-fanout", "primarySfxIntent": null},
    {"semanticIntent": "cta-resolve", "eventTypes": ["ctaTitle", "ctaRecommend"], "semanticRole": "cta-resolve", "primarySfxIntent": null},
    {"semanticIntent": "transformation-stack", "eventTypes": ["transformationStack"], "semanticRole": "transformation-stack", "primarySfxIntent": "automation_handoff"}
  ],
  "audioPolicy": {
    "sfxManifestPath": "assets/remotion-template/public/input/audio/sfx_manifest.json",
    "sfxSuggestionSource": "scripts/visual_event_builder.py:SFX_SUGGESTIONS",
    "doNotChangeVolumesInRegistryRefactor": true
  }
}
